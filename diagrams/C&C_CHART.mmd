---
config:
  layout: elk
  look: classic
  theme: redux
---
flowchart LR
 subgraph Frontend["💻 Frontend Layer"]
        USER["StoryGraph<br>WA"]
  end
 subgraph Gateway["🔐 Gateway Layer"]
        APIGW["API<br>Gateway"]
  end
 subgraph LoadBalancer["⚖️ Load Balancer Layer"]
        ALB["Application<br>Load Balancer"]
  end
 subgraph Microservices["⚙️ Microservices Layer"]
        PROFILE["User<br>Service"]
        STORY["Story<br>Service"]
        READER["Reader<br>Service"]
        NOTIFICATION["Notification<br>Service"]
  end
 subgraph BusDriver["🚍 Event Bus Layer"]
        READING[("Event Bus")]
  end
 subgraph SQLDB["🟣 PostgreSQL"]
        SQLAUTH[("Users<br>Data")]
        SQLMETA[("Story<br>Metadata")]
        SQLPROGRESS[("Reader<br> Progress")]
  end
 subgraph NoSQLDBCluster["🟢 MongoDB"]
        NoSQLSTORY[("Story Nodes<br>&amp; Graph")]
  end
 subgraph RedisCluster["🔴 Redis Cache"]
        REDISPROGRESS[("Reader<br>Progress")]
        REDISUSER[("User<br>Cache")]
  end
 subgraph Databases["🗄️ Data Storage Layer"]
        SQLDB
        NoSQLDBCluster
        RedisCluster
  end
 subgraph Sistema["☁️ StoryGraph Cloud-Native System"]
        Frontend
        Gateway
        LoadBalancer
        Microservices
        BusDriver
        Databases
  end
 subgraph Externos["🌐 External Services"]
        OAUTH["Auth<br>Service"]
        n2["Storage<br>Service"]
        n3["Serverless<br>Function"]
  end
    USER ==> APIGW
    APIGW -. REST API .-> ALB
    ALB -. REST API .-> PROFILE & STORY & READER
    PROFILE -- SQL <br> Driver --> SQLAUTH
    PROFILE -- Redis <br> Client --> REDISUSER
    STORY -- SQL <br> Driver --> SQLMETA
    STORY -- MongoDB <br> Driver --> NoSQLSTORY
    READER -- Redis <br> Client --> REDISPROGRESS
    STORY == Publish <br> Events ==> READING
    READER == Publish <br> Events ==> READING
    READING == Subscribe ==> NOTIFICATION
    READING == Subscribe ==> PROFILE
    PROFILE -. "OAuth 2.0" .-> OAUTH
    READER -- SQL <br> Driver --> SQLPROGRESS
    PROFILE -. REST API .-> n2
    n3 == Publish <br> Events ==> READING
    OAUTH -. REST API .-> n3
    USER -. Fetch <br> Assets .-> n2
    Databases ~~~ Externos

     USER:::frontend
     APIGW:::gateway
     ALB:::loadbalancer
     PROFILE:::authservice
     STORY:::storyservice
     READER:::coreservice
     NOTIFICATION:::notifservice
     READING:::eventbus
     SQLAUTH:::sqldb
     SQLMETA:::sqldb
     SQLPROGRESS:::sqldb
     NoSQLSTORY:::nosqldb
     REDISPROGRESS:::redisdb
     REDISUSER:::redisdb
     OAUTH:::external
     n2:::external
     n3:::external
